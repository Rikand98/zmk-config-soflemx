#include "keys_sv.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

// Encoders & LEDs (matching base config without forcing status = "okay")
&led_strip { chain-length = <30>; };

&sensors { triggers-per-rotation = <30>; };

&left_encoder { steps = <60>; };

&right_encoder { steps = <60>; };

// Responsive Tap-Hold tuning for Neovim Ctrl/Esc
&mt {
    tapping-term-ms = <175>;
    quick-tap-ms = <150>;
    flavor = "balanced";
};

#define BASE   0
#define LOWER  1
#define RAISE  2
#define ADJUST 3

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // J + K = Escape (instant Normal mode)
        vim_esc {
            bindings = <&kp ESCAPE>;
            key-positions = <31 32>;
            timeout-ms = <40>;
        };

        // K + L = Backspace (right home row)
        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <32 33>;
            timeout-ms = <40>;
        };

        // Left Shift + Right Shift = CAPS_WORD
        caps_word_combo {
            bindings = <&caps>;
            key-positions = <24 49>;
        };
    };

    macros {
        // -> (Python type hints / R)
        arrow_thin: arrow_thin {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SV_MINUS &kp LS(INT1)>;
        };

        // => (Arrow functions / JS / Scala)
        arrow_fat: arrow_fat {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SV_EQUAL &kp LS(INT1)>;
        };

        // != (SQL / Python / Lua inequality)
        not_equal: not_equal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SV_EXCL &kp SV_EQUAL>;
        };
    };

    behaviors {
        caps: caps {
            compatible = "zmk,behavior-caps-word";
            label = "CAPS";
            #binding-cells = <0>;
            continue-list = <POUND MINUS BACKSPACE UNDERSCORE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";

            // |  ESC  |  1  |  2  |  3   |  4   |  5   |               |  6   |  7    |  8    |  9   |   0   |   +   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |               |  Y   |  U    |  I    |  O   |   P   |   Å   |
            // |CTL/ESC|  A  |  S  |  D   |  F   |  G   |               |  H   |  J    |  K    |  L   |   Ö   |   Ä   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   | MUTE | | PLAY |  N   |  M    |  ,    |  .   |   -   | SHIFT |
            //               | ALT | CMD  | BSPC | LOWER| SPACE| | ENTER| RAISE| CMD   | CTL   | CAPS |

            bindings = <
&gresc          &kp SV_N1  &kp SV_N2  &kp SV_N3  &kp SV_N4  &kp SV_N5                                 &kp SV_N6  &kp SV_N7  &kp SV_N8     &kp SV_N9    &kp SV_N0        &kp SV_PLUS
&kp TAB         &kp SV_Q   &kp SV_W   &kp SV_E   &kp SV_R   &kp SV_T                                  &kp SV_Y   &kp SV_U   &kp SV_I      &kp SV_O     &kp SV_P         &kp SV_A_RING
&mt LCTRL ESC   &kp SV_A   &kp SV_S   &kp SV_D   &kp SV_F   &kp SV_G                                  &kp SV_H   &kp SV_J   &kp SV_K      &kp SV_L     &kp SV_O_UMLAUT  &kp SV_A_UMLAUT
&kp LEFT_SHIFT  &kp SV_Z   &kp SV_X   &kp SV_C   &kp SV_V   &kp SV_B   &kp C_MUTE    &kp C_PLAY_PAUSE &kp SV_N   &kp SV_M   &kp SV_COMMA  &kp SV_DOT   &kp SV_MINUS     &kp RSHFT
                           &kp LALT  &kp LGUI   &kp BSPC   &mo LOWER  &kp SPACE     &kp ENTER        &mo RAISE  &kp RGUI   &kp RCTL       &kp CLCK
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp UP DOWN>;
        };

        lower_layer {
            display-name = "Symbols";

            // |  §    |  F1 |  F2 |  F3  |  F4  |  F5  |               |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // |  `    |  !  |  @  |  #   |  $   |  %   |               |  ^   |  &    |  *    |  (   |   )   |  F12  |
            // |  ~    |  =  |  -  |  +   |  /   |  \   |               |  |   |  {    |  }    |  [   |   ]   |   :   |
            // | trans |  <  |  >  |  ;   |  :   |  "   | trans| | trans|  _   |  ?    |  <    |  >   |   '   |  DEL  |
            //               |trans| trans| trans| trans| trans| | trans| trans| trans | trans | trans|

            bindings = <
&kp GRAVE      &kp F1        &kp F2        &kp F3        &kp F4        &kp F5                          &kp F6         &kp F7         &kp F8         &kp F9         &kp F10       &kp F11
&kp SV_GRAVE   &kp SV_EXCL   &kp LA(N2)    &kp SV_HASH   &kp LA(N4)    &kp SV_PRCNT                    &kp SV_CARET   &kp SV_AMPS    &kp SV_ASTRK   &kp SV_LPAR    &kp SV_RPAR   &kp F12
&kp LA(RBKT)   &kp SV_EQUAL  &kp SV_MINUS  &kp SV_PLUS   &kp SV_FSLH   &kp LA(LS(N7))                  &kp LA(N7)     &kp LA(LS(N8)) &kp LA(LS(N9)) &kp LA(N8)     &kp LA(N9)    &kp SV_COLON
&trans         &kp INT1      &kp LS(INT1)  &kp SV_SEMI   &kp SV_COLON  &kp SV_DQT    &trans    &trans  &kp SV_UNDER   &kp SV_QMARK   &kp INT1       &kp LS(INT1)   &kp SV_SQT    &kp DELETE
                             &trans        &trans        &trans        &trans        &trans    &trans  &trans         &trans         &trans         &trans
            >;

            sensor-bindings =
                <&inc_dec_kp LEFT_ARROW RIGHT_ARROW>,
                <&inc_dec_kp UP_ARROW DOWN_ARROW>;
        };

        raise_layer {
            display-name = "NavNum";

            // | trans |  =  |  /  |  *   |  -   |  +   |               |  !=  |  ->   |  =>   | trans| trans | trans |
            // | trans |  ,  |  7  |  8   |  9   |  .   |               | HOME | PGUP  | PGDN  | END  | WRD<- | WRD-> |
            // | trans |  0  |  4  |  5   |  6   | CAPS |               |  <-  |   v   |   ^   |  ->  |  DEL  | BKSPC |
            // | trans | UNDO|  1  |  2   |  3   | COPY | trans| | trans| PASTE|  CUT  | trans | trans| trans | trans |
            //               |trans| trans| trans| trans| trans| | trans| trans| trans | trans | trans|

            bindings = <
&trans  &kp SV_EQUAL  &kp SV_FSLH  &kp SV_ASTRK  &kp SV_MINUS  &kp SV_PLUS                     &not_equal  &arrow_thin  &arrow_fat  &trans        &trans        &trans
&trans  &kp SV_COMMA  &kp SV_N7    &kp SV_N8     &kp SV_N9     &kp SV_DOT                      &kp HOME    &kp PG_UP    &kp PG_DN   &kp END       &kp LA(LEFT)  &kp LA(RIGHT)
&trans  &kp SV_N0     &kp SV_N4    &kp SV_N5     &kp SV_N6     &kp CLCK                        &kp LEFT    &kp DOWN     &kp UP      &kp RIGHT     &kp DEL       &kp BSPC
&trans  &kp LG(Z)     &kp SV_N1    &kp SV_N2     &kp SV_N3     &kp LG(C)     &trans    &trans  &kp LG(V)   &kp LG(X)    &trans      &trans        &trans        &trans
                      &trans       &trans        &trans        &trans        &trans    &trans  &trans      &trans       &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        adjust_layer {
            display-name = "Adjust";

            // |STUDIO |  F1 |  F2 |  F3  |  F4  |  F5  |               |  F6  |  F7   |  F8   |  F9  |  F10  | none  |
            // |EXTPWR |RGBHD|RGBHI|RGBSD |RGBSI |RGBEF |               | none | none  | none  | none | none  | none  |
            // |BOOTLDR|RGBBD|RGBBI|RGBSP |RGBSD |SYSRST|               | none | none  | none  | none | none  | none  |
            // |  BT0  | BT1 | BT2 | BT3  | BT4  | none |RGBTOG| | none | BTCLR|BTCLRA |  USB  |  BLE |BOOTLDR| none  |
            //               |none | none | none | none | none | | none | none | none  | none  | none |

            bindings = <
&studio_unlock    &kp F1          &kp F2          &kp F3          &kp F4          &kp F5                                          &kp F6     &kp F7         &kp F8        &kp F9       &kp F10     &none
&ext_power EP_TOG &rgb_ug RGB_HUD &rgb_ug RGB_HUI &rgb_ug RGB_SAD &rgb_ug RGB_SAI &rgb_ug RGB_EFF                                 &none      &none          &none         &none        &none       &none
&bootloader       &rgb_ug RGB_BRD &rgb_ug RGB_BRI &rgb_ug RGB_SPI &rgb_ug RGB_SPD &sys_reset                                      &none      &none          &none         &none        &none       &none
&bt BT_SEL 0      &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4    &none            &rgb_ug RGB_TOG    &none       &bt BT_CLR &bt BT_CLR_ALL &out OUT_USB  &out OUT_BLE &bootloader &none
                                  &none           &none           &none           &none            &none              &none       &none      &none          &none         &none
            >;

            sensor-bindings = <&inc_dec_kp C_BRI_UP C_BRI_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
